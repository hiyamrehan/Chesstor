diff --git a/app/src/index.css b/app/src/index.css
new file mode 100644
index 0000000..ba52a1a
--- /dev/null
+++ b/app/src/index.css
@@ -0,0 +1,404 @@
+@import url("https://fonts.googleapis.com/css2?family=Aboreto&family=Inter:wght@400;500;600&display=swap");
+@import "tailwindcss";
+
+:root {
+  --bg: #1e1e1e;
+  --bg-deep: #151515;
+  --bronze: #af8e71;
+  --bronze-light: #cfb59d;
+  --text: #dcdcdc;
+  --muted: rgba(220, 220, 220, 0.6);
+  --best: #8faf8a;
+  --amber: #d1a45c;
+  --danger: #b5524f;
+  --glass: rgba(255, 255, 255, 0.055);
+  --glass-strong: rgba(255, 255, 255, 0.085);
+  --border: rgba(175, 142, 113, 0.29);
+  --radius: 24px;
+  --shadow: 0 18px 50px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.08);
+}
+
+* { box-sizing: border-box; }
+html, body, #root { min-height: 100%; margin: 0; }
+body { background: #101010; color: var(--text); font-family: "Inter", sans-serif; }
+button { font: inherit; }
+button:focus-visible { outline: 2px solid var(--bronze-light); outline-offset: 3px; }
