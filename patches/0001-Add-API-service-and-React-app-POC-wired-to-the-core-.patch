+++ b/src/chesstor/api/analysis.py
@@ -0,0 +1,121 @@
+"""PGN game review: per-move engine evaluation, accuracy and quality classes (templated text only).
+
+Explanations are deterministic templates built from engine numbers; no language model decides truth.
+Accuracy uses the win-probability formulation published by Lichess (documented there); we cite it as an
+adapted heuristic, not our contribution.
+"""
+from __future__ import annotations
+
+import io
+import math
+
+import chess
+import chess.pgn
+
+from .engine_service import ENGINE
+
+MAX_PLIES = 240
+
+
+def win_pct(cp: float) -> float:
+    cp = max(-1000.0, min(1000.0, cp))
+    return 50 + 50 * (2 / (1 + math.exp(-0.00368208 * cp)) - 1)
+
+
+def move_accuracy(win_before: float, win_after: float) -> float:
+    drop = max(0.0, win_before - win_after)
+    return max(0.0, min(100.0, 103.1668 * math.exp(-0.04354 * drop) - 3.1669))
+
+
+def tag_for(loss_cp: float, is_best: bool) -> str:
+    if is_best or loss_cp <= 10:
+        return "Best"
+    if loss_cp <= 60:
+        return "Good"
+    if loss_cp <= 200:
+        return "Mistake"
+    return "Blunder"
+
+
+def _pawns(cp: float) -> str:
+    return f"{cp / 100:+.2f}"
+
+
+def _text(tag: str, loss: float, better: str | None) -> str:
+    if tag == "Best":
+        return "Matches the engine's first choice."
+    if tag == "Good":
+        return f"Close to best; loses about {loss / 100:.1f} pawns."
+    if tag == "Mistake":
+        return f"Loses about {loss / 100:.1f} pawns compared with {better}."
+    return f"Loses about {loss / 100:.1f} pawns; {better} was much stronger."
+
+
+class PgnError(ValueError):
+    pass
+
+
+def parse_pgn(text: str) -> chess.pgn.Game:
+    game = chess.pgn.read_game(io.StringIO(text))
+    if game is None or not list(game.mainline_moves()):
+        raise PgnError("No moves found in this PGN.")
+    return game
+
+
+def analyse_game(text: str, color: str = "white", time_ms: int = 120) -> dict:
+    game = parse_pgn(text)
+    if not ENGINE.available:
+        raise RuntimeError(ENGINE.error or "Stockfish unavailable")
+    board = game.board()
+    moves = list(game.mainline_moves())[:MAX_PLIES]
+
+    def best_of(b: chess.Board) -> tuple[int, str | None]:
+        if b.is_game_over():
+            r = b.outcome().winner if b.outcome() else None
+            cp = 0 if r is None else (10000 if r == b.turn else -10000)
+            return cp, None
+        lines = ENGINE.lines(b, 1, time_ms)
+        return lines[0]["cp"], lines[0]["uci"]
+
+    rows: list[dict] = []
+    series: list[int] = []                           # white-POV cp after each ply, index 0 = start
+    cp_to_move, best_uci = best_of(board)
+    series.append(cp_to_move if board.turn else -cp_to_move)
+    for i, mv in enumerate(moves):
+        mover = board.turn
+        fen_before = board.fen()
+        better_san = board.san(chess.Move.from_uci(best_uci)) if best_uci else None
+        played_san = board.san(mv)
+        is_best = best_uci == mv.uci()
+        before_pov = cp_to_move                       # best-play eval for the mover
+        board.push(mv)
+        cp_to_move, next_best = best_of(board)
+        after_pov = -cp_to_move                       # same mover's POV after the move
+        loss = max(0.0, before_pov - after_pov)
+        tag = tag_for(loss, is_best)
+        rows.append({
+            "ply": i + 1, "no": f"{i // 2 + 1}." if mover else f"{i // 2 + 1}...",
+            "color": "white" if mover else "black", "san": played_san, "tag": tag,
+            "loss_cp": round(loss), "eval_after_cp": after_pov if mover else -after_pov,
+            "better": better_san if not is_best else played_san, "fen_before": fen_before,
+            "better_uci": best_uci, "text": _text(tag, loss, better_san),
+            "accuracy": round(move_accuracy(win_pct(before_pov), win_pct(after_pov)), 1),
+        })
+        series.append(cp_to_move if board.turn else -cp_to_move)
+        best_uci = next_best
+
+    def summary(side: str) -> dict:
+        mine = [r for r in rows if r["color"] == side]
+        counts = {t: sum(1 for r in mine if r["tag"] == t) for t in ("Best", "Good", "Mistake", "Blunder")}
+        acc = sum(r["accuracy"] for r in mine) / len(mine) if mine else 0.0
+        return {"accuracy": round(acc), "counts": counts, "moves": len(mine)}
+
+    headers = game.headers
+    return {
+        "headers": {k: headers.get(k, "") for k in ("White", "Black", "Result", "Date", "Event")},
+        "plies": len(rows), "color": color,
+        "summary": {"white": summary("white"), "black": summary("black")},
+        "series_cp": [max(-600, min(600, c)) for c in series],
+        "moves": rows,
+        "engine": {"time_ms_per_position": time_ms, "name": "Stockfish"},
+    }
diff --git a/src/chesstor/api/app.py b/src/chesstor/api/app.py
new file mode 100644
index 0000000..9ea2575
--- /dev/null
+++ b/src/chesstor/api/app.py
@@ -0,0 +1,139 @@
+"""HTTP API used by the Chesstor app (web and, via Capacitor, phone).
+
+Privacy: raw frames are processed in memory and never stored; only derived state (FEN/moves) is kept.
+"""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+import chess
+from fastapi import FastAPI, File, Form, HTTPException, UploadFile
+from fastapi.middleware.cors import CORSMiddleware
+from fastapi.staticfiles import StaticFiles
+from pydantic import BaseModel
+
+from .. import __version__
+from ..vision.frame import decode_image
+from .analysis import PgnError, analyse_game
+from .engine_service import ENGINE
+from .sessions import CalibrationError, LiveSession
+
+MAX_UPLOAD = 25 * 1024 * 1024
+SESSIONS: dict[str, LiveSession] = {}
+MAX_SESSIONS = 50
+
+
+class NewSession(BaseModel):
+    color: str = "white"
+    simulated: bool = False
+
+
+class Manual(BaseModel):
+    fen: str | None = None
+
+
+def _get(sid: str) -> LiveSession:
+    s = SESSIONS.get(sid)
+    if s is None:
+        raise HTTPException(404, "unknown session")
+    return s
+
+
+def create_app(static_dir: str | None = None) -> FastAPI:
+    app = FastAPI(title="Chesstor API", version=__version__)
+    origins = os.environ.get("CHESSTOR_CORS", "*").split(",")
+    app.add_middleware(CORSMiddleware, allow_origins=origins, allow_methods=["*"], allow_headers=["*"])
+
+    @app.get("/api/health")
+    def health() -> dict:
+        return {"ok": True, "version": __version__, "engine": ENGINE.available, "engine_error": ENGINE.error}
+
+    @app.post("/api/sessions")
+    def new_session(req: NewSession) -> dict:
+        if len(SESSIONS) >= MAX_SESSIONS:
+            oldest = min(SESSIONS.values(), key=lambda s: s.created)
+            SESSIONS.pop(oldest.id, None)
+        s = LiveSession(req.color, req.simulated)
+        SESSIONS[s.id] = s
+        return s.snapshot()
+
+    @app.get("/api/sessions/{sid}")
+    def get_session(sid: str) -> dict:
+        return _get(sid).snapshot()
+
+    @app.post("/api/sessions/{sid}/calibrate")
+    async def calibrate(sid: str, image: UploadFile = File(...), corners: str = Form(...)) -> dict:
+        s = _get(sid)
+        try:
+            pts = json.loads(corners)
+            return s.calibrate(decode_image(await image.read()), pts)
+        except (CalibrationError, ValueError, json.JSONDecodeError) as exc:
+            raise HTTPException(422, str(exc)) from exc
+
+    @app.post("/api/sessions/{sid}/frame")
+    async def frame(sid: str, image: UploadFile = File(...), t: float | None = Form(None)) -> dict:
+        s = _get(sid)
+        data = await image.read()
+        if len(data) > MAX_UPLOAD:
+            raise HTTPException(413, "frame too large")
+        try:
+            return s.process_frame(decode_image(data), t)
+        except CalibrationError as exc:
+            raise HTTPException(409, str(exc)) from exc
+        except ValueError as exc:
+            raise HTTPException(422, str(exc)) from exc
+
+    @app.post("/api/sessions/{sid}/tick")
+    def tick(sid: str, n: int = 5) -> dict:
+        s = _get(sid)
+        if not s.simulated:
+            raise HTTPException(409, "tick is only for simulated sessions")
+        return s.tick(max(1, min(n, 60)))
+
+    @app.post("/api/sessions/{sid}/manual")
+    def manual(sid: str, req: Manual) -> dict:
+        try:
+            return _get(sid).manual(req.fen)
+        except ValueError as exc:
+            raise HTTPException(422, str(exc)) from exc
+
+    @app.delete("/api/sessions/{sid}")
+    def end(sid: str) -> dict:
+        s = _get(sid)
+        pgn = s.pgn()
+        SESSIONS.pop(sid, None)
+        return {"pgn": pgn, "moves": s.san}
+
+    @app.post("/api/analyze/pgn")
+    async def analyze_pgn(file: UploadFile | None = File(None), text: str | None = Form(None),
+                          color: str = Form("white"), time_ms: int = Form(120)) -> dict:
+        raw = text if text else (await file.read()).decode("utf-8", errors="replace") if file else ""
+        if not raw.strip():
+            raise HTTPException(422, "no PGN provided")
+        try:
+            return analyse_game(raw, color, max(30, min(time_ms, 1000)))
+        except PgnError as exc:
+            raise HTTPException(422, str(exc)) from exc
+        except RuntimeError as exc:
+            raise HTTPException(503, str(exc)) from exc
+
+    @app.post("/api/analyze/video")
+    def analyze_video() -> dict:
+        raise HTTPException(501, "Video analysis is planned for Iteration 2 (needs board auto-detection).")
+
+    @app.get("/api/validate-fen")
+    def validate_fen(fen: str) -> dict:
+        try:
+            return {"valid": chess.Board(fen).is_valid()}
+        except ValueError:
+            return {"valid": False}
+
+    sd = static_dir or os.environ.get("CHESSTOR_STATIC")
+    if sd and Path(sd).is_dir():
+        app.mount("/", StaticFiles(directory=sd, html=True), name="app")
+    return app
+
+
+app = create_app()
diff --git a/src/chesstor/api/engine_service.py b/src/chesstor/api/engine_service.py
new file mode 100644
index 0000000..8f535a6
--- /dev/null
+++ b/src/chesstor/api/engine_service.py
@@ -0,0 +1,71 @@
+"""Process-wide lazy Stockfish service with graceful degradation (the app works, minus advice, without it)."""
+from __future__ import annotations
+
+import os
+import threading
+from concurrent.futures import ThreadPoolExecutor
+
+import chess
+
+from ..engine import EngineUnavailable, StockfishAnalyzer, analyse_lines
+
+
+def classify(lines: list[dict]) -> list[dict]:
+    """Label each line by centipawn loss vs. the best line (tones used by the UI: best/amber/danger)."""
+    if not lines:
+        return []
+    best = max(line["cp"] for line in lines)
+    out = []
+    for line in lines:
+        loss = best - line["cp"]
+        tone = "best" if loss <= 20 else "amber" if loss <= 120 else "danger"
+        out.append({**line, "loss_cp": loss, "tone": tone})
+    return out
+
+
+class EngineService:
+    def __init__(self) -> None:
+        self._an: StockfishAnalyzer | None = None
+        self._lock = threading.Lock()
+        self._pool = ThreadPoolExecutor(max_workers=1)
+        self.error: str | None = None
+        self.time_ms = int(os.environ.get("CHESSTOR_ENGINE_MS", "300"))
+
+    def _get(self) -> StockfishAnalyzer | None:
+        if self._an is None and self.error is None:
+            try:
+                self._an = StockfishAnalyzer(os.environ.get("CHESSTOR_STOCKFISH"), self.time_ms, 3)
+            except (EngineUnavailable, OSError) as exc:      # binary missing / not executable
+                self.error = str(exc)
+        return self._an
+
+    @property
+    def available(self) -> bool:
+        with self._lock:
+            return self._get() is not None
+
+    def lines(self, board: chess.Board, multipv: int = 3, time_ms: int | None = None) -> list[dict] | None:
+        with self._lock:
+            an = self._get()
+            if an is None:
+                return None
+            return analyse_lines(an, board, multipv, time_ms)
+
+    def submit(self, board: chess.Board, callback) -> None:
+        """Analyse in the background; callback(fen, lines|None). Only confirmed states are ever submitted."""
+        fen = board.fen()
+        b = board.copy()
+
+        def job() -> None:
+            callback(fen, self.lines(b))
+
+        self._pool.submit(job)
+
+    def close(self) -> None:
+        with self._lock:
+            if self._an is not None:
+                self._an.close()
+                self._an = None
+
+
+ENGINE = EngineService()
diff --git a/src/chesstor/api/sessions.py b/src/chesstor/api/sessions.py
new file mode 100644
index 0000000..638ea4d
--- /dev/null
+++ b/src/chesstor/api/sessions.py
@@ -0,0 +1,210 @@
+"""Live session: glue between camera frames (or a simulated feed), the tracker and the engine."""
+from __future__ import annotations
+
+import threading
+import time
+import uuid
+
+import chess
+import chess.pgn
+import numpy as np
+
+from ..config import TrackerConfig
+from ..observation import ObservationFrame
+from ..simulate import SimConfig, SimFrame, simulate_game
+from ..tracker import State, Tracker
+from ..vision.frame import occlusion_mask, quality_score
+from ..vision.geometry import homography, order_corners, rectify
+from ..vision.occupancy import OccupancyModel
+from .engine_service import ENGINE, classify
+
+STATUS = {
+    State.IDLE: "Not started",
+    State.CALIBRATING: "Align the board",
+    State.INITIALIZING: "Reading starting position",
+    State.TRACKING: "Board locked · Tracking",
+    State.TRANSITION: "Move detected · confirming",
+    State.CONFIRMING: "Move detected · confirming",
+    State.UNCERTAIN: "Not sure · suggestions paused",
+    State.LOST_BOARD: "Board lost · re-align",
+    State.MANUAL_CORRECTION: "Needs your help · restore the board",
+    State.ENDED: "Session ended",
+}
+
+DEMO_SAN = "e4 e5 Nf3 Nc6 Bc4 Bc5 O-O Nf6 d3 O-O Nc3 d6 Bg5 h6 Bh4 g5 Bg3 Nh5"
+
+
+class CalibrationError(ValueError):
+    pass
+
+
+def demo_moves() -> list[chess.Move]:
+    b, out = chess.Board(), []
+    for san in DEMO_SAN.split():
+        m = b.parse_san(san)
+        out.append(m)
+        b.push(m)
+    return out
+
+
+class LiveSession:
+    def __init__(self, color: str = "white", simulated: bool = False, cfg: TrackerConfig | None = None,
+                 sim_seed: int = 7):
+        self.id = uuid.uuid4().hex[:12]
+        self.color = color if color in ("white", "black") else "white"
+        self.simulated = simulated
+        self.created = time.time()
+        self.lock = threading.RLock()
+        self.tracker = Tracker(cfg)
+        self.model: OccupancyModel | None = None
+        self.H: np.ndarray | None = None
+        self.san: list[str] = []
+        self.last_move: dict | None = None
+        self.last_quality = 1.0
+        self.last_visible = 1.0
+        self.analysis: dict = {"status": "idle", "fen": None, "lines": []}
+        self._frames: list[SimFrame] = []
+        self._i = 0
+        self._t0 = time.monotonic()
+        if simulated:
+            self._frames, _ = simulate_game(chess.Board(), demo_moves(),
+                                            SimConfig(seed=sim_seed, persist_prob=0.0, hover_prob=0.4))
+            self.tracker.start()
+            self._request_analysis()
+
+    # ---- camera path ---------------------------------------------------------------------------
+    def calibrate(self, img: np.ndarray, corners_norm: list[list[float]]) -> dict:
+        """Manual four-corner calibration (spec s.8 POC strategy). Board orientation is detected by trying
+        all four rotations and keeping the one in which the standard starting position is recognised."""
+        if self.simulated:
+            raise CalibrationError("simulated session needs no calibration")
+        if len(corners_norm) != 4:
+            raise CalibrationError("exactly four corners are required")
+        h, w = img.shape[:2]
+        pts = np.asarray(corners_norm, dtype=np.float32) * np.array([w, h], dtype=np.float32)
+        ordered = order_corners(pts)
+        best: tuple[int, np.ndarray, OccupancyModel] | None = None
+        for k in range(4):
+            c = np.roll(ordered, -k, axis=0)
+            H = homography(c, reorder=False)
+            canon = rectify(img, H)
+            try:
+                model = OccupancyModel().calibrate(canon)
+            except ValueError:
+                continue
+            score = model.start_position_matches(canon)
+            if best is None or score > best[0]:
+                best = (score, H, model)
+        if best is None or best[0] < 60:
+            raise CalibrationError("Could not recognise the starting position. Set up all 32 pieces, "
+                                   "make sure the board is fully visible and tap its four outer corners.")
+        with self.lock:
+            _, self.H, self.model = best
+            if self.tracker.state == State.IDLE:
+                self.tracker.start()
+            elif self.tracker.state == State.LOST_BOARD:
+                self.tracker.board_recovered()
+            self._request_analysis()
+        return self.snapshot()
+
+    def process_frame(self, img: np.ndarray, t: float | None = None) -> dict:
+        with self.lock:
+            if self.model is None or self.H is None:
+                raise CalibrationError("not calibrated")
+            t = (time.monotonic() - self._t0) if t is None else t
+            canon = rectify(img, self.H)
+            self.last_quality = quality_score(canon)
+            vis = occlusion_mask(canon)
+            self.last_visible = float(vis.mean())
+            frame = ObservationFrame(t, self.model.predict(canon), vis, self.last_quality)
+            self._feed(frame)
+            return self.snapshot()
+
+    # ---- simulated path ------------------------------------------------------------------------
+    def tick(self, n: int = 5) -> dict:
+        with self.lock:
+            for _ in range(n):
+                if self._i >= len(self._frames):
+                    break
+                sf = self._frames[self._i]
+                self._i += 1
+                self.last_quality, self.last_visible = sf.frame.quality, sf.frame.visible_fraction
+                self._feed(sf.frame)
+            return self.snapshot()
+
+    # ---- shared --------------------------------------------------------------------------------
+    def _feed(self, frame: ObservationFrame) -> None:
+        board_before = self.tracker.board.copy()
+        commit = self.tracker.update(frame)
+        if commit is None:
+            return
+        b = board_before
+        for m, s in zip(commit.moves, commit.san, strict=True):
+            self.san.append(s)
+            self.last_move = {"san": s, "uci": m.uci(), "from": chess.square_name(m.from_square),
+                              "to": chess.square_name(m.to_square), "color": "white" if b.turn else "black"}
+            b.push(m)
+        self._request_analysis()
+
+    def _request_analysis(self) -> None:
+        board = self.tracker.board
+        self.analysis = {"status": "pending", "fen": board.fen(), "lines": []}
+
+        def done(fen: str, lines: list[dict] | None) -> None:
+            with self.lock:
+                if self.analysis.get("fen") != fen:        # state moved on: discard stale result
+                    return
+                if lines is None:
+                    self.analysis = {"status": "unavailable", "fen": fen, "lines": [],
+                                     "reason": ENGINE.error or "engine unavailable"}
+                else:
+                    self.analysis = {"status": "ready", "fen": fen, "lines": classify(lines)}
+
+        ENGINE.submit(board, done)
+
+    def manual(self, fen: str | None = None) -> dict:
+        with self.lock:
+            board = chess.Board(fen) if fen else self.tracker.board.copy()
+            if not board.is_valid():
+                raise ValueError("invalid position")
+            if self.tracker.state in (State.TRACKING, State.UNCERTAIN, State.TRANSITION,
+                                      State.MANUAL_CORRECTION):
+                self.tracker.manual_set(board)
+            self._request_analysis()
+            return self.snapshot()
+
+    def pgn(self) -> str:
+        game = chess.pgn.Game()
+        game.headers["Event"] = "Chesstor live session"
+        game.headers["Site"] = "Chesstor"
+        node = game
+        b = chess.Board()
+        # rebuild from SAN history so the PGN is always legal and consistent with the trusted state
+        for s in self.san:
+            try:
+                m = b.parse_san(s)
+            except ValueError:
+                break
+            node = node.add_variation(m)
+            b.push(m)
+        return str(game)
+
+    def snapshot(self) -> dict:
+        tr = self.tracker
+        board = tr.board
+        s = tr.stats
+        uncertain = tr.state in (State.UNCERTAIN, State.MANUAL_CORRECTION, State.LOST_BOARD)
+        return {
+            "id": self.id, "simulated": self.simulated, "color": self.color,
+            "state": tr.state.value, "status": STATUS[tr.state], "uncertain": uncertain,
+            "needs_manual": tr.state == State.MANUAL_CORRECTION,
+            "calibrated": self.simulated or self.model is not None,
+            "fen": board.fen(), "turn": "white" if board.turn else "black",
+            "ply": len(self.san), "moves": list(self.san), "last_move": self.last_move,
+            "quality": round(self.last_quality, 3), "visible_fraction": round(self.last_visible, 3),
+            "stats": {"frames": s.frames, "dropped": s.dropped, "commits": s.commits,
+                      "uncertain_entries": s.uncertain_entries, "manual_requests": s.manual_requests},
+            "analysis": self.analysis if not uncertain else {**self.analysis, "status": "paused"},
+            "demo": {"done": self._i >= len(self._frames), "progress": self._i, "total": len(self._frames)}
+            if self.simulated else None,
+        }
