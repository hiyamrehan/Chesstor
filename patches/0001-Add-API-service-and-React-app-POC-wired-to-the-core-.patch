@@ -0,0 +1,44 @@
+import { GLYPH, fenToCells, orient, squareCentre, type Color } from "./lib";
+
+interface Props {
+  fen: string;
+  orientation?: Color;
+  lastMove?: { from: string; to: string } | null;
+  arrow?: { from: string; to: string } | null;
+  className?: string;
+}
+
+/** Board rendered from a FEN. Used for the simulated feed, the move review and anywhere a position is shown. */
+export default function BoardView({ fen, orientation = "white", lastMove, arrow, className = "" }: Props) {
+  let cells;
+  try {
+    cells = orient(fenToCells(fen), orientation);
+  } catch {
+    return <div className={`board-view ${className}`} role="img" aria-label="Invalid position" />;
+  }
+  const a = arrow ? squareCentre(arrow.from, orientation) : null;
+  const b = arrow ? squareCentre(arrow.to, orientation) : null;
+  return (
+    <div className={`board-view ${className}`} role="img" aria-label={`Chess position ${fen.split(" ")[0]}`}>
+      {cells.map((c, i) => {
+        const dark = (c.square.charCodeAt(0) - 97 + Number(c.square[1])) % 2 === 1; // a1 is dark
+        const hl = lastMove && (c.square === lastMove.from || c.square === lastMove.to);
+        return (
+          <i key={i} className={`${dark ? "dk" : "lt"} ${hl ? "hl" : ""}`}>
+            {c.piece && <b className={c.piece === c.piece.toUpperCase() ? "w" : "b"}>{GLYPH[c.piece.toLowerCase()]}</b>}
+          </i>
+        );
+      })}
+      {a && b && (
+        <svg viewBox="0 0 100 100" aria-hidden="true">
+          <defs>
+            <marker id="bv-arrow" markerWidth="4" markerHeight="4" refX="2.4" refY="2" orient="auto">
+              <path d="M0 0 4 2 0 4Z" />
+            </marker>
+          </defs>
+          <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} markerEnd="url(#bv-arrow)" />
+        </svg>
+      )}
+    </div>
+  );
+}
diff --git a/app/src/Live.tsx b/app/src/Live.tsx
new file mode 100644
index 0000000..29a5eb4
--- /dev/null
+++ b/app/src/Live.tsx
@@ -0,0 +1,321 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { api, ApiError, type EngineLine, type Snapshot } from "./api";
+import BoardView from "./Board";
+import { contentRect, fmtEval, speakSan, tapToNormalised, type Color } from "./lib";
+import { Back, Icon, Pressable, Glass } from "./ui";
+
+type Phase = "starting" | "calibrate" | "running" | "error";
+
+const STATE_TONE: Record<string, string> = {
+  TRACKING: "var(--best)",
+  TRANSITION: "var(--amber)",
+  CONFIRMING: "var(--amber)",
+  UNCERTAIN: "var(--danger)",
+  MANUAL_CORRECTION: "var(--danger)",
+  LOST_BOARD: "var(--danger)",
+};
+
+function grabFrame(video: HTMLVideoElement, maxW = 960): Promise<Blob> {
+  const scale = Math.min(1, maxW / video.videoWidth);
+  const canvas = document.createElement("canvas");
+  canvas.width = Math.round(video.videoWidth * scale);
+  canvas.height = Math.round(video.videoHeight * scale);
+  canvas.getContext("2d")!.drawImage(video, 0, 0, canvas.width, canvas.height);
+  return new Promise((resolve, reject) =>
+    canvas.toBlob((b) => (b ? resolve(b) : reject(new Error("frame capture failed"))), "image/jpeg", 0.85),
+  );
+}
+
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+function speak(text: string) {
+  if (typeof window === "undefined" || !("speechSynthesis" in window)) return;
+  window.speechSynthesis.cancel();
+  window.speechSynthesis.speak(new SpeechSynthesisUtterance(text));
+}
+
+function lineRows(snap: Snapshot): { label: string; line: EngineLine; copy: string; tone: string }[] {
+  const lines = snap.analysis.lines;
+  return lines.map((l, i) => {
+    const e = fmtEval(l.cp, l.mate, snap.turn, snap.color);
+    const label = i === 0 ? "Best move" : l.tone === "best" ? "Also strong" : l.tone === "amber" ? "Suboptimal" : "Avoid";
+    const copy = i === 0 ? `Engine evaluation ${e}` : `${e} · loses ${(l.loss_cp / 100).toFixed(1)} pawns vs best`;
+    return { label, line: l, copy, tone: l.tone };
+  });
+}
+
+export default function LiveSession({
+  color,
+  simulated,
+  onExit,
+  onFinished,
+}: {
+  color: Color;
+  simulated: boolean;
+  onExit: () => void;
+  onFinished: (pgn: string, moves: string[]) => void;
+}) {
+  const [voice, setVoice] = useState(true);
+  const [phase, setPhase] = useState<Phase>("starting");
+  const [snap, setSnap] = useState<Snapshot | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [taps, setTaps] = useState<{ px: [number, number]; n: [number, number] }[]>([]);
+  const [busy, setBusy] = useState(false);
+  const videoRef = useRef<HTMLVideoElement>(null);
+  const boxRef = useRef<HTMLDivElement>(null);
+  const sidRef = useRef<string | null>(null);
+  const aliveRef = useRef(true);
+  const spokenRef = useRef<string | null>(null);
+  const streamRef = useRef<MediaStream | null>(null);
+
+  // ---- session + camera lifecycle ---------------------------------------------------------------
+  useEffect(() => {
+    aliveRef.current = true;
+    (async () => {
+      try {
+        const s = await api.createSession(color, simulated);
+        if (!aliveRef.current) return;
+        sidRef.current = s.id;
+        setSnap(s);
+        if (simulated) return setPhase("running");
+        if (!navigator.mediaDevices?.getUserMedia) {
+          throw new Error(
+            "Camera not available here (browsers only allow it on HTTPS or localhost). Use the phone app, an HTTPS tunnel, or the simulated demo feed.",
+          );
+        }
+        const stream = await navigator.mediaDevices.getUserMedia({
+          video: { facingMode: { ideal: "environment" }, width: { ideal: 1280 }, height: { ideal: 720 } },
+          audio: false,
+        });
+        streamRef.current = stream;
+        if (videoRef.current) {
+          videoRef.current.srcObject = stream;
+          await videoRef.current.play().catch(() => undefined);
+        }
+        setPhase("calibrate");
+      } catch (e) {
+        setError(e instanceof Error ? e.message : String(e));
+        setPhase("error");
+      }
+    })();
+    return () => {
+      aliveRef.current = false;
+      streamRef.current?.getTracks().forEach((t) => t.stop());
+      window.speechSynthesis?.cancel();
+    };
+  }, [color, simulated]);
+
+  // ---- main loops ---------------------------------------------------------------------------------
+  useEffect(() => {
+    if (phase !== "running" || !sidRef.current) return;
+    const sid = sidRef.current;
+    let stop = false;
+    (async () => {
+      let failures = 0;
+      while (!stop && aliveRef.current) {
+        const t0 = performance.now();
+        try {
+          let s: Snapshot;
+          if (simulated) {
+            s = await api.tick(sid, 5);
+            await sleep(Math.max(0, 333 - (performance.now() - t0)));
+          } else {
+            const v = videoRef.current;
+            if (!v || !v.videoWidth) {
+              await sleep(100);
+              continue;
+            }
+            s = await api.frame(sid, await grabFrame(v), performance.now() / 1000);
+            await sleep(Math.max(0, 140 - (performance.now() - t0)));
+          }
+          failures = 0;
+          if (!stop) setSnap(s);
+          if (simulated && s.demo?.done) break;
+        } catch (e) {
+          failures += 1;
+          if (failures >= 5) {
+            setError(e instanceof ApiError ? e.message : "Lost connection to the Chesstor server.");
+            setPhase("error");
+            return;
+          }
+          await sleep(400);
+        }
+      }
+    })();
+    return () => {
+      stop = true;
+    };
+  }, [phase, simulated]);
+
+  // ---- voice: speak the engine's best move once per new position, only on the user's turn -----------
+  useEffect(() => {
+    if (!voice || !snap || snap.analysis.status !== "ready" || snap.turn !== snap.color) return;
+    if (spokenRef.current === snap.analysis.fen) return;
+    spokenRef.current = snap.analysis.fen;
+    const best = snap.analysis.lines[0];
+    if (best) speak(`Best move: ${speakSan(best.san)}`);
+  }, [snap, voice]);
+
+  // ---- calibration ------------------------------------------------------------------------------------
+  const onTap = (ev: React.PointerEvent<HTMLDivElement>) => {
+    const box = boxRef.current;
+    const v = videoRef.current;
+    if (phase !== "calibrate" || !box || !v?.videoWidth || taps.length >= 4) return;
+    const r = box.getBoundingClientRect();
+    const px: [number, number] = [ev.clientX - r.left, ev.clientY - r.top];
+    const n = tapToNormalised(px[0], px[1], contentRect(r.width, r.height, v.videoWidth, v.videoHeight));
+    if (n) setTaps([...taps, { px, n }]);
+  };
+
+  const confirmCalibration = useCallback(async () => {
+    const v = videoRef.current;
+    if (!v || !sidRef.current) return;
+    setBusy(true);
+    setError(null);
+    try {
+      const s = await api.calibrate(sidRef.current, await grabFrame(v), taps.map((t) => t.n));
+      setSnap(s);
+      setPhase("running");
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+      setTaps([]);
+    } finally {
+      setBusy(false);
+    }
+  }, [taps]);
+
+  const resync = async () => {
+    if (!sidRef.current) return;
+    try {
+      setSnap(await api.manual(sidRef.current));
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+    }
+  };
+
+  const end = async () => {
+    const sid = sidRef.current;
+    aliveRef.current = false;
+    streamRef.current?.getTracks().forEach((t) => t.stop());
+    if (!sid) return onExit();
+    try {
+      const r = await api.end(sid);
+      onFinished(r.pgn, r.moves);
+    } catch {
+      onExit();
+    }
+  };
+
+  // ---- render --------------------------------------------------------------------------------------------
+  const tone = snap ? (STATE_TONE[snap.state] ?? "var(--muted)") : "var(--muted)";
+  const rows = snap && snap.analysis.status === "ready" && snap.turn === snap.color ? lineRows(snap) : [];
+  const first = snap?.analysis.lines[0];
+  const evalLabel = first && snap ? fmtEval(first.cp, first.mate, snap.turn, snap.color) : "—";
+  const lm = snap?.last_move;
+
+  return (
+    <main className="screen live-screen">
+      <div className="camera-field">
+        <div className="live-top">
+          <Back onClick={() => void end()} />
+          <div>
+            <span className="live-pill"><i /> {simulated ? "DEMO" : "LIVE"}</span>
+            <p>Move {snap ? Math.floor(snap.ply / 2) + 1 : 1}</p>
+          </div>
+          <Pressable className={`voice-toggle glass ${voice ? "on" : ""}`} onClick={() => setVoice(!voice)}>
+            <Icon name="sound" size={16} /><span>AI Voice</span>
+          </Pressable>
+        </div>
+
+        {simulated ? (
+          <div className="live-stage">
+            {snap && <BoardView fen={snap.fen} orientation={color} lastMove={lm} className="live-boardview" />}
+            <p className="sim-tag">Simulated camera feed · hand occlusion injected</p>
+          </div>
+        ) : (
+          <div className="live-stage" ref={boxRef} onPointerDown={onTap}>
+            <video ref={videoRef} className="live-video" playsInline muted autoPlay />
+            {phase === "calibrate" && (
+              <>
+                {taps.map((t, i) => (
+                  <span key={i} className="corner-dot" style={{ left: t.px[0], top: t.px[1] }}>{i + 1}</span>
+                ))}
+                <div className="calib-hint glass">
+                  <strong>{taps.length < 4 ? `Tap board corner ${taps.length + 1} of 4` : "Corners set"}</strong>
+                  <span>Set up all 32 pieces first. Tap the four outer corners of the board, in any order.</span>
+                  <div className="calib-actions">
+                    <Pressable className="mini-button" onClick={() => setTaps([])} disabled={!taps.length}>Reset</Pressable>
+                    <Pressable className="mini-button confirm" onClick={() => void confirmCalibration()} disabled={taps.length !== 4 || busy}>
+                      {busy ? "Checking…" : "Lock board"}
+                    </Pressable>
+                  </div>
+                </div>
+              </>
+            )}
+            {phase === "running" && taps.length === 4 && (
+              <svg className="lock-outline" aria-hidden="true">
+                <polygon points={[0, 1, 2, 3].map((i) => taps[i].px.join(",")).join(" ")} />
+              </svg>
+            )}
+          </div>
+        )}
+        {simulated && <div className="ar-frame"><i className="tl" /><i className="tr" /><i className="bl" /><i className="br" /></div>}
+
+        {phase === "error" && (
+          <div className="live-error glass">
+            <Icon name="shield" size={18} />
+            <p>{error}</p>
+            <Pressable className="mini-button" onClick={onExit}>Back</Pressable>
+          </div>
+        )}
+        {phase === "running" && snap && (
+          <p className="tracking-label"><span style={{ background: tone, boxShadow: `0 0 8px ${tone}` }} /> {snap.status}</p>
+        )}
+        {phase === "calibrate" && error && <p className="calib-error">{error}</p>}
+      </div>
+
+      <section className="feedback-sheet glass">
+        <div className="sheet-handle" />
+        <div className="feedback-title">
+          <div>
+            <p className="eyebrow">{lm ? (lm.color === color ? "You played" : "Opponent played") : "Waiting for the first move"}</p>
+            <h2>{lm ? <strong>{lm.san}</strong> : "Make a move on the board"}</h2>
+          </div>
+          <span className="eval-score">{evalLabel}</span>
+        </div>
+        <div className="feedback-list">
+          {!snap || phase === "calibrate" || phase === "starting" ? (
+            <Glass className="feedback-note">Align the board to begin tracking.</Glass>
+          ) : snap.analysis.status === "paused" ? (
+            <div className="feedback-row danger"><i className="eval-bar" /><span className="feedback-mark"><Icon name="close" size={14} /></span>
+              <div><p>Not sure</p><h3>Suggestions paused</h3><span>The board reading is ambiguous, so advice would be unreliable.</span></div></div>
+          ) : snap.analysis.status === "unavailable" ? (
+            <Glass className="feedback-note">Engine unavailable on the server. Tracking continues without advice.</Glass>
+          ) : snap.analysis.status === "pending" ? (
+            <Glass className="feedback-note">Analyzing the new position…</Glass>
+          ) : snap.turn !== snap.color ? (
+            <Glass className="feedback-note">Opponent to move. Engine expects <strong>{first?.san}</strong>.</Glass>
+          ) : (
+            rows.map((r) => (
+              <div className={`feedback-row ${r.tone}`} key={r.line.uci}>
+                <i className="eval-bar" />
+                <span className="feedback-mark"><Icon name={r.tone === "best" ? "check" : r.tone === "amber" ? "spark" : "close"} size={14} /></span>
+                <div><p>{r.label}</p><h3>{r.line.san}</h3><span>{r.copy}</span></div>
+              </div>
+            ))
+          )}
+        </div>
+        <div className="session-actions">
+          {snap?.needs_manual ? (
+            <Pressable className="mini-button confirm" onClick={() => void resync()}>I restored the board</Pressable>
+          ) : (
+            <Pressable className="mini-button" onClick={() => first && speak(`Best move: ${speakSan(first.san)}`)}>
+              <Icon name="sound" size={16} /> Replay voice
+            </Pressable>
+          )}
+          <Pressable className="mini-button end-button" onClick={() => void end()}>End Session</Pressable>
+        </div>
+      </section>
+    </main>
+  );
+}
diff --git a/app/src/Review.tsx b/app/src/Review.tsx
new file mode 100644
index 0000000..e17afa7
--- /dev/null
+++ b/app/src/Review.tsx
@@ -0,0 +1,229 @@
+import { useEffect, useRef, useState } from "react";
+import { api, ApiError, type Review, type ReviewTag } from "./api";
+import BoardView from "./Board";
+import { fmtPawns, seriesPath, type Color } from "./lib";
+import chesstorLogo from "./imports/chesstor-logo.png";
+import { AccuracyRing, Back, Glass, Icon, PageHeader, Pressable, PrimaryButton, type Screen } from "./ui";
+
+export interface PgnJob {
+  text: string;
+  color: Color;
+  origin: "upload" | "live";
+}
+
+export function UploadScreen({
+  kind,
+  navigate,
+  analyze,
+}: {
+  kind: "PGN" | "Video";
+  navigate: (s: Screen) => void;
+  analyze: (text: string) => void;
+}) {
+  const isVideo = kind === "Video";
+  const input = useRef<HTMLInputElement>(null);
+  const [file, setFile] = useState<{ name: string; size: number; text: string } | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [err, setErr] = useState<string | null>(null);
+
+  const pick = async (f: File | undefined) => {
+    if (!f) return;
+    setErr(null);
+    setNotice(null);
+    if (!isVideo && f.size > 2_000_000) return setErr("That file is too large for a PGN (max 2 MB).");
+    setFile({ name: f.name, size: f.size, text: isVideo ? "" : await f.text() });
+  };
+
+  const onContinue = async () => {
+    if (!file) return;
+    if (!isVideo) return analyze(file.text);
+    try {
+      await api.analyzeVideo();
+    } catch (e) {
+      setNotice(e instanceof ApiError ? e.message : "Video analysis is not available yet.");
+    }
+  };
+
+  return (
+    <main className="screen centered-flow upload-screen">
+      <PageHeader title={`Upload ${kind}`} eyebrow="Game analysis" onBack={() => navigate("home")} />
+      <p className="lead">{isVideo ? "Turn your recorded match into clear, actionable insights." : "Import a saved game and uncover every critical moment."}</p>
+      <input ref={input} type="file" hidden accept={isVideo ? "video/mp4,video/quicktime" : ".pgn,text/plain"} onChange={(e) => void pick(e.target.files?.[0])} />
+      {!file ? (
+        <Pressable className="dropzone glass" onClick={() => input.current?.click()}>
+          <span className="upload-icon"><Icon name="upload" size={25} /></span>
+          <h2>Tap to upload your {isVideo ? "game video" : ".pgn file"}</h2>
+          <p>Supported: {isVideo ? "MP4, MOV" : ".pgn"}</p>
+          <span className="browse-chip">Choose file</span>
+        </Pressable>
+      ) : (
+        <Glass className="uploaded-card">
+          <span className="file-tile"><Icon name={isVideo ? "play" : "file"} size={23} /></span>
+          <div className="file-info">
+            <span className="success-label"><Icon name="check" size={12} /> Ready</span>
+            <h3>{file.name}</h3>
+            <p>{(file.size / 1024).toFixed(file.size > 1e6 ? 0 : 1)} KB</p>
+          </div>
+          <Pressable className="remove-button" onClick={() => setFile(null)} ariaLabel="Remove file"><Icon name="close" size={16} /></Pressable>
+        </Glass>
+      )}
+      {err && <p className="inline-error">{err}</p>}
+      {notice && <p className="inline-notice">{notice} Use PGN upload or Live tracking meanwhile.</p>}
+      <Glass className="privacy-note"><Icon name="shield" size={18} /><p><strong>Your game stays private.</strong><br />Only the moves are analysed; nothing is shared.</p></Glass>
+      <div className="flow-footer"><PrimaryButton disabled={!file} onClick={() => void onContinue()}>Continue <Icon name="arrow" size={18} /></PrimaryButton></div>
+    </main>
+  );
+}
+
+export function AnalysisLoading({
+  job,
+  navigate,
+  onDone,
+}: {
+  job: PgnJob | null;
+  navigate: (s: Screen) => void;
+  onDone: (r: Review) => void;
+}) {
+  const [progress, setProgress] = useState(8);
+  const [error, setError] = useState<string | null>(null);
+  const [attempt, setAttempt] = useState(0);
+  const back = job?.origin === "live" ? "home" : "pgn";
+
+  useEffect(() => {
+    const timer = window.setInterval(() => setProgress((v) => Math.min(v + 3, 92)), 450);
+    return () => window.clearInterval(timer);
+  }, [attempt]);
+
+  useEffect(() => {
+    if (!job) return;
+    let cancelled = false;
+    setError(null);
+    setProgress(8);
+    api.analyzePgn(job.text, job.color).then(
+      (r) => {
+        if (cancelled) return;
+        setProgress(100);
+        window.setTimeout(() => !cancelled && onDone(r), 350);
+      },
+      (e) => !cancelled && setError(e instanceof Error ? e.message : String(e)),
+    );
+    return () => {
+      cancelled = true;
+    };
+  }, [job, attempt, onDone]);
+
+  const status = progress < 35 ? "Reading moves..." : progress < 70 ? "Evaluating positions..." : "Generating insights...";
+  return (
+    <main className="screen loading-screen">
+      <Back onClick={() => navigate(back)} />
+      <div className="loading-content">
+        <div className="knight-loader"><img src={chesstorLogo} alt="Chesstor knight logo" /><i /></div>
+        <p className="eyebrow">Chesstor intelligence</p>
+        <h1>Analyzing your game</h1>
+        <p className="lead">Every position is checked by Stockfish</p>
+        {error ? (
+          <Glass className="progress-card">
+            <p className="inline-error">{error}</p>
+            <Pressable className="mini-button" onClick={() => setAttempt(attempt + 1)}>Try again</Pressable>
+          </Glass>
+        ) : (
+          <Glass className="progress-card">
+            <div className="progress-meta"><span>{status}</span><strong>{progress}%</strong></div>
+            <div className="progress-track"><i style={{ width: `${progress}%` }} /></div>
+            <div className="analysis-steps">
+              <span className="done"><Icon name="check" size={12} /> Import</span>
+              <span className={progress > 35 ? "done" : ""}><Icon name="spark" size={12} /> Evaluate</span>
+              <span className={progress > 70 ? "done" : ""}><Icon name="chart" size={12} /> Insights</span>
+            </div>
+          </Glass>
+        )}
+      </div>
+    </main>
+  );
+}
+
+const TONE: Record<ReviewTag, string> = { Best: "best", Good: "good", Mistake: "amber", Blunder: "danger" };
+
+function EvaluationGraph({ review, side }: { review: Review; side: Color }) {
+  const { line, area, pts } = seriesPath(review.series_cp);
+  const last = review.series_cp[review.series_cp.length - 1] ?? 0;
+  const marks = review.moves.filter((m) => m.color === side && (m.tag === "Mistake" || m.tag === "Blunder"));
+  return (
+    <Glass className="graph-card">
+      <div className="card-heading"><div><p className="eyebrow">Game evaluation</p><h2>Advantage</h2></div><span className="eval-score">{fmtPawns(last)}</span></div>
+      <svg className="line-graph" viewBox="0 0 310 112" preserveAspectRatio="none" aria-label="Evaluation graph">
+        <defs><linearGradient id="area" x1="0" y1="0" x2="0" y2="1"><stop stopColor="var(--bronze)" stopOpacity=".36" /><stop offset="1" stopColor="var(--bronze)" stopOpacity="0" /></linearGradient></defs>
+        <path className="grid-line" d="M0 26H310M0 56H310M0 86H310" />
+        <path className="graph-area" d={area} />
+        <path className="graph-line" d={line} />
+        {marks.map((m) => {
+          const p = pts[m.ply] ?? pts[pts.length - 1];
+          return <circle key={m.ply} cx={p[0]} cy={p[1]} r="4" className={m.tag === "Blunder" ? "blunder-dot" : "mistake-dot"} />;
+        })}
+      </svg>
+      <div className="graph-labels"><span>1</span><span>{Math.round(review.plies / 4)}</span><span>{Math.round(review.plies / 2)}</span><span>{Math.round((review.plies * 3) / 4)}</span><span>{review.plies}</span></div>
+    </Glass>
+  );
+}
+
+export function AnalysisResult({
+  review,
+  initialSide,
+  navigate,
+}: {
+  review: Review;
+  initialSide: Color;
+  navigate: (s: Screen) => void;
+}) {
+  const [side, setSide] = useState<Color>(initialSide);
+  const [filter, setFilter] = useState("All");
+  const [expanded, setExpanded] = useState<number | null>(null);
+  const sum = review.summary[side];
+  const mine = review.moves.filter((m) => m.color === side);
+  const shown = filter === "All" ? mine : mine.filter((m) => m.tag === filter || (filter === "Mistakes" && m.tag === "Mistake") || (filter === "Blunders" && m.tag === "Blunder"));
+  const quality = [
+    { label: "Best", value: sum.counts.Best, tone: "best" },
+    { label: "Good", value: sum.counts.Good, tone: "good" },
+    { label: "Mistakes", value: sum.counts.Mistake, tone: "amber" },
+    { label: "Blunders", value: sum.counts.Blunder, tone: "danger" },
+  ];
+  const h = review.headers;
+  const headline = sum.accuracy >= 90 ? "Excellent precision" : sum.accuracy >= 75 ? "Strong performance" : sum.accuracy >= 55 ? "Room to sharpen" : "A tough game";
+  return (
+    <main className="screen result-screen">
+      <PageHeader title="Game analysis" eyebrow={`${h.Date && h.Date !== "????.??.??" ? h.Date : "Your game"} · ${review.plies} plies`} onBack={() => navigate("home")} action={h.Result && h.Result !== "*" ? <span className="result-chip">{h.Result}</span> : undefined} />
+      <div className="side-switch" role="group" aria-label="Review side">
+        {(["white", "black"] as const).map((c) => (
+          <Pressable key={c} className={side === c ? "active" : ""} onClick={() => { setSide(c); setExpanded(null); }}>{c === "white" ? "White" : "Black"}{h[c === "white" ? "White" : "Black"] && h[c === "white" ? "White" : "Black"] !== "?" ? ` · ${h[c === "white" ? "White" : "Black"]}` : ""}</Pressable>
+        ))}
+      </div>
+      <Glass className="summary-card">
+        <AccuracyRing value={sum.accuracy} />
+        <div className="summary-copy"><p className="eyebrow">{headline}</p><h2>{sum.moves} moves reviewed</h2><p>Accuracy compares each move with the engine's best, using win probability.</p></div>
+        <div className="quality-grid">{quality.map((q) => <div key={q.label}><i className={q.tone} /><strong>{q.value}</strong><span>{q.label}</span></div>)}</div>
+      </Glass>
+      <EvaluationGraph review={review} side={side} />
+      <div className="filter-row">{["All", "Mistakes", "Blunders", "Best"].map((f) => <Pressable key={f} className={filter === f ? "active" : ""} onClick={() => setFilter(f)}>{f}</Pressable>)}</div>
+      <div className="moves-list">
+        {shown.length === 0 && <Glass className="feedback-note">No moves in this category.</Glass>}
+        {shown.map((m) => (
+          <Pressable key={m.ply} className={`move-card glass ${expanded === m.ply ? "expanded" : ""}`} onClick={() => setExpanded(expanded === m.ply ? null : m.ply)}>
+            <span className="timestamp">ply {m.ply}</span>
+            <div className="move-main">
+              <div><span>{m.no}</span><h3>{m.san}</h3><em className={TONE[m.tag]}>{m.tag}</em></div>
+              <p>{m.text}</p>
+              {m.tag !== "Best" && m.better && <span className="better">Better: <strong>{m.better}</strong></span>}
+            </div>
+            <Icon name="chevron" size={16} />
+            {expanded === m.ply && (
+              <div className="mini-board-wrap">
+                <BoardView fen={m.fen_before} orientation={side} arrow={m.better_uci ? { from: m.better_uci.slice(0, 2), to: m.better_uci.slice(2, 4) } : null} className="mini" />
+                <p><span>Engine's line</span> {m.tag === "Best" ? "You found the engine's choice here." : `${m.better} keeps more of your advantage (you lost ${(m.loss_cp / 100).toFixed(1)} pawns).`}</p>
+              </div>
+            )}
+          </Pressable>
+        ))}
+      </div>
+    </main>
+  );
+}
